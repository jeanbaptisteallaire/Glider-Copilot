// Copier en Secrets.xcconfig (ignoré par git) et renseigner la clé PRECOG (préfixe pcg_).
PRECOG_API_KEY =
// Supabase (même projet qu'Android) : URL et clé publique anon.
SUPABASE_URL =
SUPABASE_ANON_KEY =
// Google Sign-In (projet Google Cloud GLIDY) : client iOS, son schéma inversé, client Web (celui de Supabase)
GOOGLE_IOS_CLIENT_ID = 000000000000-xxxx.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.000000000000-xxxx
GOOGLE_WEB_CLIENT_ID = 000000000000-yyyy.apps.googleusercontent.com
