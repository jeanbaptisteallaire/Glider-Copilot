<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (S9). Même comportement qu'avant, rendu explicite :
  - aucune sauvegarde vers le cloud Google (cohérent avec la politique de confidentialité : rien ne quitte le téléphone) ;
  - transfert direct d'un téléphone à l'autre (câble / Wi-Fi local, à l'initiative du pilote) autorisé,
    pour ne pas perdre les traces IGC et les réglages en changeant de téléphone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <!-- S12 : la session du compte GLIDY ne suit pas le téléphone (reconnexion par code sur le nouveau) -->
        <exclude domain="sharedpref" path="glidy_cloud_session.xml" />
    </device-transfer>
</data-extraction-rules>
